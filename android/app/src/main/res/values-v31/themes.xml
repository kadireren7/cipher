<resources>
    <!-- Android 12+ system splash screen: black, with the Cipher mark. No animation, no text. -->
    <style name="Theme.Cipher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cipher_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/cipher_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
    </style>
</resources>
