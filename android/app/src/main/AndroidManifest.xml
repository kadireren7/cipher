<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app ask whether the device has a network at all (to tell "offline" from "relay unreachable"). Normal permission, no prompt; it reveals
         nothing about the network itself. Without it ConnectivityManager.getActiveNetwork() throws SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the window hide SYSTEM_ALERT_WINDOW overlays while Cipher is visible (tapjacking defence, API 31+). Normal permission. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- No storage, contacts, location, phone, or accounts permissions: attachments come from the system picker. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".CipherApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Cipher">

        <!-- The only activity. Not exported except as the launcher; no deep links, no intent filters other than MAIN/LAUNCHER. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The embedded Tor daemon: its own process (the C Tor code never shares an address space with the vault or the keys), not exported, no
             intent filter. The library's own TorService entry is removed so this is the only service in the merged manifest. -->
        <service
            android:name=".net.tor.CipherTorService"
            android:process=":tor"
            android:exported="false" />
        <service
            android:name="org.torproject.jni.TorService"
            tools:node="remove" />

        <!-- A library (androidx.profileinstaller) adds an EXPORTED receiver (shell-only via the DUMP permission). We do not use it:
             remove it so the only exported component of the merged manifest is the launcher activity. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
