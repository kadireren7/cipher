# PLACEHOLDERS ONLY. Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- relay (crates/cipher-relay) ---
# Identity of this relay; bound into every request signature. It is the HOST[:PORT] exactly as clients dial it (lowercase, NOT a URL:
# the client signs with the host of the configured https:// address). A mismatch makes every signed request fail with 401.
CIPHER_RELAY_AUDIENCE=relay.example.invalid
# Account-level registration credential. >= 32 random characters (e.g. `openssl rand -base64 36`).
CIPHER_RELAY_REGISTRATION_TOKEN=<generate-a-long-random-value>
CIPHER_RELAY_LISTEN=0.0.0.0:8443
# TLS 1.3 certificate + key (PEM). Required unless INSECURE_DEV_HTTP=1 on a loopback address.
CIPHER_RELAY_TLS_CERT=/path/to/fullchain.pem
CIPHER_RELAY_TLS_KEY=/path/to/privkey.pem
# PostgreSQL connection string (never logged). TLS to the database is mandatory unless the host is loopback.
CIPHER_RELAY_DATABASE_URL=postgres://cipher_relay:<password>@db.internal:5432/cipher
# CIPHER_RELAY_DB_CA=/path/to/db-ca.pem
# CIPHER_RELAY_DB_POOL=16
# Secret pepper (>= 32 chars) hashed into rate-limit keys so IPs/device ids cannot be recovered from a database dump.
CIPHER_RELAY_PEPPER=<generate-a-long-random-value>
# Load shedding and limits (defaults are sensible; excess is rejected with 503, never queued without bound).
# CIPHER_RELAY_MAX_INFLIGHT=256
# CIPHER_RELAY_MAX_CONNECTIONS=1024
# CIPHER_RELAY_REQUEST_TIMEOUT_SECS=30
# Global cap on stored encrypted attachment bytes (default 10 GiB).
# CIPHER_RELAY_MAX_BLOB_BYTES=10737418240
# DEV ONLY: plain HTTP, accepted only when CIPHER_RELAY_LISTEN is a loopback address.
# CIPHER_RELAY_INSECURE_DEV_HTTP=1

# --- logging ---
RUST_LOG=info
