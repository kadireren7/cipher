# ---------------------------------------------------------------------------------------------------------------------------
# Cipher .gitignore. Anything that could be a secret, a personal artifact or a build/test by-product stays OUT of the repository.
# Public TEST fixtures that are intentionally committed are plain source files (e.g. the placeholder values in .env.example and the
# documented dev-only PostgreSQL password in CI) — never keys. Throwaway test CAs are GENERATED by scripts/make-test-ca.sh into ignored paths.
# ---------------------------------------------------------------------------------------------------------------------------

# build outputs
/target
**/target/
**/build/
.gradle/
.cxx/
.externalNativeBuild/
captures/
**/node_modules
*.apk
*.aab
*.ap_
*.dex
release-artifacts/

# secrets, keys, certificates with private material, environment files (only .env.example is committed)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
keystore.properties
signing.properties
*.der
*.csr
*.srl
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json
*.gpg
*.asc
id_rsa*
id_ed25519*

# android local configuration and generated resources (the debug-only test CA certificate is generated, not committed)
local.properties
android/.gradle/
android/build/
android/app/build/
android/app/src/debug/res/raw/
*.hprof
*.iml

# databases, vaults, dumps, logs, traces, captured traffic, emulator state
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-*
*.sql.gz
*.dump
*.log
*.trace
*.pcap
*.pcapng
*.har
*.snapshot
*.sav
*.bak
*.orig
*.rej
*.tar
*.tgz
*.tar.gz
*.zip
vault/
*.vault
peer-state/
test-peers/
scratch/
tmp/

# fuzzing: corpora and artifacts are large and may contain crashing inputs; they are regenerated (see CONTRIBUTING.md)
fuzz/target
fuzz/artifacts
fuzz/corpus
fuzz/coverage

# coverage, profiling, benchmarks
coverage/
*.profraw
*.profdata
lcov.info
cobertura.xml
flamegraph*.svg
perf.data*

# IDE / OS / editor
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# self-hosting data (secrets, onion keys, backups)
deploy/data/
deploy/.env
